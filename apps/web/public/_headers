/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# No long-lived cache rule for /assets/*: a missing file falls back to index.html, and a
# year-long "immutable" header would pin that HTML in the browser under the script's URL.
# Cloudflare's default (max-age=0, must-revalidate + ETag) costs one 304 per file instead.
