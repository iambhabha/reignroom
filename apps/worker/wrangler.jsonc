{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reignroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The site (apps/web build output). Only /api/* reaches the Worker code; every other
  // path is a static file, or index.html for client-side routes like /r/ABC234.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object per room, SQLite-backed (the only backend on the Workers Free plan).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "exports": {
    "RoomDO": { "type": "durable-object", "storage": "sqlite" }
  },

  // Per-IP limits, counted per Cloudflare location. Tune `limit` here (no code change needed);
  // `period` must be 10 or 60 seconds. Mobile carriers often put many users behind one IP
  // (CGNAT), so raise these if real players get "rate_limited" when creating or joining rooms.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Extra origins allowed to open room sockets, comma-separated. Same-origin is always allowed.
    // Local development overrides this in .dev.vars.
    "ALLOWED_ORIGINS": ""
  },

  "observability": { "enabled": true }
}
