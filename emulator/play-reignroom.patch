+//ReignRoom: controller input for both pads comes from JavaScript.
+//- Free play: setPadState() sets a pad's current state; the game reads it at its next frame.
+//- Netplay (lockstep): pushFrameInput() queues both pads' state for an exact frame number, and
+//  the emulator waits at each frame until that frame's input is there, so two players' emulators
+//  given the same inputs run the same game. Every HASH_EVERY frames it records a hash of EE and
+//  IOP RAM so the two games can be compared.
+extern std::atomic<int64> g_reignroomClockOverride;
+
+class CPH_ReignRoom : public CPadHandler
+{
+public:
+	static constexpr uint32 PADS = 2;
+	static constexpr uint32 RING = 1024;
+	static constexpr uint32 HASH_EVERY = 60;
+	static constexpr uint32 HASH_RING = 4096;
+
+	//Packed pad state: bits 0-19 buttons (PS2::CControllerInfo order), then LX, LY, RX, RY bytes.
+	static uint64 Pack(uint32 buttons, uint32 lx, uint32 ly, uint32 rx, uint32 ry)
+	{
+		return (buttons & 0xFFFFF) | (static_cast<uint64>(lx & 0xFF) << 24) | (static_cast<uint64>(ly & 0xFF) << 32) |
+		       (static_cast<uint64>(rx & 0xFF) << 40) | (static_cast<uint64>(ry & 0xFF) << 48);
+	}
+	static constexpr uint64 NEUTRAL = (0x7FULL << 24) | (0x7FULL << 32) | (0x7FULL << 40) | (0x7FULL << 48);
+
+	void SetCurrent(uint32 pad, uint64 state)
+	{
+		if(pad < PADS) m_current[pad].store(state);
+	}
+
+	void StartLockstep(int64 clockBase)
+	{
+		m_clockBase = clockBase;
+		m_ready.store(m_frame.load());
+		m_lockstep.store(true);
+	}
+
+	void StopLockstep()
+	{
+		m_lockstep.store(false);
+		g_reignroomClockOverride.store(-1);
+	}
+
+	//Frames must be pushed in order, starting at the current frame, at most RING ahead.
+	bool PushFrame(uint32 frame, uint64 pad0, uint64 pad1)
+	{
+		uint32 ready = m_ready.load();
+		if(frame != ready || frame >= m_frame.load() + RING) return false;
+		m_ring[frame % RING][0] = pad0;
+		m_ring[frame % RING][1] = pad1;
+		m_ready.store(frame + 1);
+		return true;
+	}
+
+	void Update(uint8* ram) override
+	{
+		uint32 frame = m_frame.load();
+		uint64 pads[PADS];
+		if(m_lockstep.load())
+		{
+			while(m_lockstep.load() && m_ready.load() <= frame)
+			{
+				std::this_thread::sleep_for(std::chrono::microseconds(200));
+			}
+			pads[0] = m_ring[frame % RING][0];
+			pads[1] = m_ring[frame % RING][1];
+			g_reignroomClockOverride.store(m_clockBase + frame / 60);
+		}
+		else
+		{
+			pads[0] = m_current[0].load();
+			pads[1] = m_current[1].load();
+		}
+		for(auto* padInterface : m_interfaces)
+		{
+			for(uint32 pad = 0; pad < PADS; pad++)
+			{
+				for(uint32 button = 0; button < PS2::CControllerInfo::MAX_BUTTONS; button++)
+				{
+					auto id = static_cast<PS2::CControllerInfo::BUTTON>(button);
+					if(PS2::CControllerInfo::IsAxis(id))
+						padInterface->SetAxisState(pad, id, static_cast<uint8>(pads[pad] >> (24 + 8 * button)), ram);
+					else
+						padInterface->SetButtonState(pad, id, (pads[pad] >> button) & 1, ram);
+				}
+			}
+		}
+		if(frame % HASH_EVERY == 0)
+		{
+			uint64 hash = HashBytes(ram, PS2::EE_RAM_SIZE, 0x9E3779B97F4A7C15ULL);
+			hash = HashBytes(m_iopRam, PS2::IOP_RAM_SIZE, hash);
+			uint32 index = m_hashCount.load();
+			m_hashes[index % HASH_RING] = {frame, hash};
+			m_hashCount.store(index + 1);
+		}
+		m_frame.store(frame + 1);
+	}
+
+	void SetIopRam(uint8* iopRam)
+	{
+		m_iopRam = iopRam;
+	}
+
+	uint32 GetFrame() const
+	{
+		return m_frame.load();
+	}
+	uint32 GetReady() const
+	{
+		return m_ready.load();
+	}
+	uint32 GetHashCount() const
+	{
+		return m_hashCount.load();
+	}
+	std::string GetHash(uint32 index) const
+	{
+		const auto& entry = m_hashes[index % HASH_RING];
+		char text[32];
+		snprintf(text, sizeof(text), "%u:%016llx", entry.frame, static_cast<unsigned long long>(entry.hash));
+		return text;
+	}
+
+private:
+	static uint64 HashBytes(const uint8* data, size_t size, uint64 hash)
+	{
+		if(!data) return hash;
+		for(size_t i = 0; i + 8 <= size; i += 8)
+		{
+			uint64 word;
+			memcpy(&word, data + i, 8);
+			hash = ((hash ^ word) * 0x100000001B3ULL);
+			hash ^= hash >> 29;
+		}
+		return hash;
+	}
+
+	struct HASHENTRY
+	{
+		uint32 frame = 0;
+		uint64 hash = 0;
+	};
+
+	std::atomic<uint64> m_current[PADS] = {{NEUTRAL}, {NEUTRAL}};
+	uint64 m_ring[RING][PADS] = {};
+	std::atomic<uint32> m_frame{0};
+	std::atomic<uint32> m_ready{0};
+	std::atomic<bool> m_lockstep{false};
+	int64 m_clockBase = 0;
+	uint8* m_iopRam = nullptr;
+	HASHENTRY m_hashes[HASH_RING];
+	std::atomic<uint32> m_hashCount{0};
+};
+CPH_ReignRoom* g_padHandler = nullptr;
